# 复制为 deploy/.env 后生效（bash deploy/start.sh 与 systemd 服务都会读取）
# PORT=8080              # HTTP/WebSocket 端口（0 = 随机端口，测试用）
# HOST=0.0.0.0           # 监听地址
# MAX_ROOMS=32           # 同时存在的房间上限
# MAX_IP_CONNS=8         # 每个 IP 的并发连接上限（防单人多开洪水）
# ADMIN_TOKEN=           # 运维后台 /admin 的口令。不设 = 后台完全无验证（能连到端口的人都能踢人停房）
#                        # 公网部署建议设：openssl rand -hex 24
# DEV_SRC=1              # 调试：直接以 ES 模块提供 /src 源码（生产勿开）
